<?xml version="1.0" encoding="UTF-8"?>
<!--
    Columnas que el volcado de puntos de interes desde un sistema de reservas
    anterior necesita en puntos_interes_ciudades (tabla del core).

    bs_parada        el nombre de parada del punto en el sistema anterior. Lo usa
                     ese sistema al generar sus ficheros de importacion, asi que no
                     es andamiaje: es dato de negocio.

    bs_legacy_idpoi  el identificador del punto en el sistema anterior. Solo sirve
                     para emitir un identificador estable mientras ese sistema siga
                     vivo. ES ANDAMIAJE: se retira cuando la importacion viva dentro
                     de FacturaScripts.
-->
<table>
    <column>
        <name>bs_parada</name>
        <type>character varying(250)</type>
    </column>
    <column>
        <name>bs_legacy_idpoi</name>
        <type>integer</type>
    </column>
</table>
